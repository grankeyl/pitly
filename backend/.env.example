ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://localhost:5432/pitly?sslmode=disable
# Публичный HTTPS-адрес (туннель в dev, домен в проде). Mini app и вебхуки работают только по HTTPS.
PUBLIC_URL=http://localhost:8080
# Сборка фронта (в проде). В dev фронт отдаёт Vite.
STATIC_DIR=

BOT_TOKEN=
# Короткое имя mini app из BotFather (/newapp). Пусто — используется main mini app бота.
MINIAPP_SHORT_NAME=
# Задан — бот работает через вебхук, иначе long polling.
BOT_WEBHOOK_SECRET=

COMMISSION_BPS=2000
HOLD_HOURS=24
MIN_PAYOUT=50000
CURRENCY=RUB
STATS_TZ=Europe/Moscow
PAYMENT_PROVIDER=fake
